# Dockerfile.cloudrun — gateway + Moltcraft in one container for Rosterbox Week 0.
# Moltcraft serves on 8080; gateway runs on 18789 internally.
# Bind-mount config: -v ~/.openclaw:/home/node/.clawdbot (use -p HOST:8080 for port mapping).

FROM node:22-bookworm

RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:${PATH}"
RUN corepack enable

WORKDIR /app

ARG CLAWDBOT_DOCKER_APT_PACKAGES=""
RUN if [ -n "$CLAWDBOT_DOCKER_APT_PACKAGES" ]; then \
      apt-get update && \
      DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends $CLAWDBOT_DOCKER_APT_PACKAGES curl && \
      apt-get clean && \
      rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*; \
    else \
      apt-get update && apt-get install -y --no-install-recommends curl && \
      apt-get clean && rm -rf /var/lib/apt/lists/*; \
    fi

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY ui/package.json ./ui/package.json
COPY patches ./patches
COPY scripts ./scripts

RUN pnpm install --no-frozen-lockfile

COPY . .
RUN CLAWDBOT_A2UI_SKIP_MISSING=1 pnpm build
ENV CLAWDBOT_PREFER_PNPM=1
RUN pnpm ui:install
RUN pnpm ui:build

# Moltcraft dashboard (serves on 8080, talks to gateway on 18789)
RUN npm install -g @ask-mojo/moltcraft

ENV NODE_ENV=production
USER node

EXPOSE 8080

# Start script: gateway in background, then Moltcraft (invoke via sh to avoid chmod in image)
CMD ["sh", "/app/scripts/start-cloudrun.sh"]
